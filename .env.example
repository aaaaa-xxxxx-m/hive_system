# === 智能蜂箱云服务器环境变量模板 ===
# 复制为 .env 并填入实际值 (不要提交 .env 到版本控制!)

# ========== 数据库 (MySQL 8.0) ==========
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=bee_db
MYSQL_USER=bee_user
MYSQL_PASSWORD=

# ========== 缓存 / 队列 (Redis 7) ==========
REDIS_PASSWORD=

# ========== 对象存储 (MinIO) ==========
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=audio

# ========== 监控可视化 (Grafana) ==========
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# ========== 安全 / 认证 ==========
JWT_SECRET=
API_KEY_SALT=

# ========== 模型签名 (Ed25519) ==========
MODEL_SIGNING_PRIVATE_KEY=
MODEL_SIGNING_PUBLIC_KEY=

# ========== 应用配置 ==========
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ========== 域名 / SSL (Let's Encrypt) ==========
# DOMAIN=your-domain.com
# ACME_EMAIL=admin@your-domain.com

# ========== 可选: 外部服务 ==========
# SENTRY_DSN=
# ALERT_WEBHOOK_URL=
